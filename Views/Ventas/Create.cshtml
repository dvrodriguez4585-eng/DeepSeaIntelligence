@model DeepSeaIntelligence.Models.Venta
@{ ViewData["Title"] = "Registrar venta"; }

<h2>Registrar venta</h2>

<form method="post" class="row g-3" style="max-width:700px">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger col-12"></div>

    <div class="col-12"><label class="form-label">Producto</label>
        <select asp-for="IdRecepcion" asp-items="(SelectList)ViewBag.Productos" class="form-select"><option value="">Seleccionar...</option></select></div>
    <div class="col-12"><label class="form-label">Cliente</label>
        <select asp-for="IdCliente" asp-items="(SelectList)ViewBag.Clientes" class="form-select"><option value="">Seleccionar...</option></select></div>
    <div class="col-md-6"><label class="form-label">Cantidad (kg) - mínimo @ViewBag.PedidoMinimo</label><input asp-for="CantidadVendida" class="form-control" /></div>
    <div class="col-md-6"><label class="form-label">Precio unitario</label><input asp-for="PrecioUnitario" class="form-control" /></div>
    <div class="col-md-6"><label class="form-label">Fecha</label><input asp-for="FechaVenta" type="date" class="form-control" /></div>
    <div class="col-md-6"><label class="form-label">Método de pago</label>
        <select asp-for="MetodoPago" class="form-select"><option>Efectivo</option><option>Transferencia</option><option>Tarjeta</option></select></div>

    <div class="col-12"><hr /><h5>Comercialización</h5>
        <small class="text-muted">Distribuidores y Exportación: máximo @ViewBag.LimiteDistribucion kg por venta.</small></div>
    <div class="col-md-4"><label class="form-label">Canal</label>
        <select name="canal" class="form-select">
            <option selected="@((ViewBag.Canal as string) == "Local")">Local</option>
            <option selected="@((ViewBag.Canal as string) == "Distribuidores")">Distribuidores</option>
            <option selected="@((ViewBag.Canal as string) == "Exportación")">Exportación</option>
        </select></div>
    <div class="col-md-4"><label class="form-label">Destino</label><input name="destino" value="@ViewBag.Destino" class="form-control" /></div>
    <div class="col-md-4"><label class="form-label">Responsable</label><input name="responsable" value="@ViewBag.Responsable" class="form-control" /></div>

    <div class="col-12"><label class="form-label">Observaciones</label><textarea asp-for="Observaciones" class="form-control"></textarea></div>
    <div class="col-12">
        <a class="btn btn-outline-dark" asp-action="Index">Cancelar</a>
        <button class="btn btn-dark">Registrar venta</button>
    </div>
</form>