@model IEnumerable<DeepSeaIntelligence.Models.Venta>
@{
    ViewData["Title"] = "Ventas";
    var prods = (Dictionary<int, string>)ViewBag.Productos;
    var clientes = (Dictionary<int, string>)ViewBag.Clientes;
    var coms = (Dictionary<int, DeepSeaIntelligence.Models.Comercializacion>)ViewBag.Coms;
}

<h2>Gestión de Ventas</h2>
<a class="btn btn-dark mb-3" asp-action="Create">+ Registrar venta</a>

<div class="table-responsive">
<table class="table table-bordered">
    <thead class="table-light">
        <tr><th>Código</th><th>Producto</th><th>Cliente</th><th>Cantidad</th><th>Precio unit.</th><th>Total</th><th>Fecha</th><th>Pago</th><th>Canal</th><th>Destino</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var v in Model)
    {
        var c = coms.GetValueOrDefault(v.IdVenta);
        <tr>
            <td>@v.Codigo</td>
            <td>@(prods.GetValueOrDefault(v.IdRecepcion, "(sin producto)"))</td>
            <td>@(clientes.GetValueOrDefault(v.IdCliente, "(sin cliente)"))</td>
            <td>@v.CantidadVendida kg</td>
            <td>@v.PrecioUnitario.ToString("N0")</td>
            <td>@v.PrecioTotal.ToString("N0")</td>
            <td>@v.FechaVenta.ToString("dd/MM/yyyy")</td>
            <td>@v.MetodoPago</td>
            <td>@c?.CanalVenta</td>
            <td>@c?.Destino</td>
            <td><a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@v.IdVenta" onclick="return confirm('¿Eliminar?')">Eliminar</a></td>
        </tr>
    }
    </tbody>
</table>
</div>