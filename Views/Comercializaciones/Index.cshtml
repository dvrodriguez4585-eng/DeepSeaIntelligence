@model IEnumerable<DeepSeaIntelligence.Models.Comercializacion>
@{ ViewData["Title"] = "Comercialización"; }

<h2>Comercialización</h2>
<a class="btn btn-dark mb-3" asp-action="Create">+ Nueva comercialización</a>

<div class="table-responsive">
<table class="table table-bordered">
    <thead class="table-light">
        <tr><th>ID</th><th>Venta</th><th>Canal</th><th>Destino</th><th>Fecha</th><th>Responsable</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.IdComercializacion</td>
            <td>#@c.IdVenta @c.Venta?.Recepcion?.ProductoRecibido</td>
            <td>@c.CanalVenta</td>
            <td>@c.Destino</td>
            <td>@c.FechaComercializacion.ToString("dd/MM/yyyy")</td>
            <td>@c.Responsable</td>
            <td class="text-nowrap">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.IdComercializacion">Editar</a>
                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@c.IdComercializacion" onclick="return confirm('¿Eliminar?')">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>