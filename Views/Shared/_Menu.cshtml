@if (User.Identity?.IsAuthenticated == true)
{
    <div class="small mb-2">👤 @User.Identity.Name</div>
    <form method="post" asp-controller="Cuenta" asp-action="Salir">
        <button class="btn btn-outline-light w-100">Cerrar sesión</button>
    </form>
}
else
{
    <a class="btn btn-light w-100 mb-2" href="/Cuenta/Entrar">Entrar</a>
    <a class="btn btn-outline-light w-100" href="/Cuenta/Registro">Registrarse</a>
}