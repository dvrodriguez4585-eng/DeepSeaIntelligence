@model DeepSeaIntelligence.Models.Almacenamiento
@{ ViewData["Title"] = "Registrar almacenamiento"; }

<h2>Registrar almacenamiento</h2>

<form method="post" class="row g-3" style="max-width:700px">
<div asp-validation-summary="ModelOnly" class="text-danger col-12"></div>
    <div class="col-12"><label class="form-label">Producto</label>
        <select asp-for="IdRecepcion" asp-items="(SelectList)ViewBag.Productos" class="form-select"><option value="">Seleccionar...</option></select></div>
    <div class="col-md-6"><label class="form-label">Tipo de almacenamiento</label>
        <select asp-for="TipoAlmacenamiento" class="form-select"><option>Frío</option><option>Seco</option><option>Vivo</option></select></div>
    <div class="col-md-6"><label class="form-label">Ubicación</label>
        <input asp-for="Ubicacion" class="form-control" /></div>
    <div class="col-md-6"><label class="form-label">Fecha</label>
        <input asp-for="FechaAlmacenamiento" type="date" class="form-control" /></div>
    <div class="col-md-6"><label class="form-label">Responsable</label>
        <input asp-for="Responsable" class="form-control" /></div>
    <div class="col-12"><label class="form-label">Condiciones</label>
        <textarea asp-for="Condiciones" class="form-control"></textarea></div>
    <div class="col-12">
        <a class="btn btn-outline-dark" asp-action="Index">Cancelar</a>
        <button class="btn btn-dark">Guardar</button>
    </div>
</form>