@model IEnumerable<DeepSeaIntelligence.Models.Calidad>
@{ ViewData["Title"] = "Calidad"; }

<h2>Control de Calidad</h2>
<a class="btn btn-dark mb-3" asp-action="Create">+ Nueva evaluación</a>

<div class="table-responsive">
<table class="table table-bordered">
    <thead class="table-light">
        <tr><th>ID</th><th>Producto</th><th>Color</th><th>Olor</th><th>Textura</th><th>Resultado</th><th>Fecha</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.IdCalidad</td>
            <td>@c.Recepcion?.ProductoRecibido</td>
            <td>@c.Color</td><td>@c.Olor</td><td>@c.Textura</td>
            <td>@c.Resultado</td>
            <td>@c.FechaEvaluacion.ToString("dd/MM/yyyy")</td>
            <td class="text-nowrap">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.IdCalidad">Editar</a>
                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@c.IdCalidad" onclick="return confirm('¿Eliminar?')">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>