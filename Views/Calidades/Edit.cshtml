@model DeepSeaIntelligence.Models.Calidad
@{ ViewData["Title"] = "Editar calidad"; }

<h2>Editar calidad</h2>

<form method="post" class="row g-3" style="max-width:700px">
    <input type="hidden" asp-for="IdCalidad" />
    <div class="col-12"><label class="form-label">Producto evaluado</label>
        <select asp-for="IdRecepcion" asp-items="(SelectList)ViewBag.Productos" class="form-select"><option value="">Seleccionar...</option></select></div>
    <div class="col-md-4"><label class="form-label">Color</label>
        <select asp-for="Color" class="form-select"><option>Normal</option><option>Alterado</option></select></div>
    <div class="col-md-4"><label class="form-label">Olor</label>
        <select asp-for="Olor" class="form-select"><option>Fresco</option><option>Fuerte</option></select></div>
    <div class="col-md-4"><label class="form-label">Textura</label>
        <select asp-for="Textura" class="form-select"><option>Firme</option><option>Blanda</option></select></div>
    <div class="col-md-6"><label class="form-label">Resultado</label>
        <select asp-for="Resultado" class="form-select"><option>Aprobado</option><option>Rechazado</option></select></div>
    <div class="col-md-6"><label class="form-label">Fecha de evaluación</label>
        <input asp-for="FechaEvaluacion" type="date" class="form-control" /></div>
    <div class="col-12">
        <a class="btn btn-outline-dark" asp-action="Index">Cancelar</a>
        <button class="btn btn-dark">Guardar cambios</button>
    </div>
</form>