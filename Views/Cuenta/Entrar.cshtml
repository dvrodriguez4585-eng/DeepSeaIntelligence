@model DeepSeaIntelligence.Controllers.EntrarVM
@{ ViewData["Title"] = "Iniciar sesión"; }

<h1 class="text-center">Bienvenido</h1>
<p class="text-center text-muted mb-3">Inicia sesión para continuar</p>

<form method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="form-floating mb-3">
        <input asp-for="Email" class="form-control" placeholder="Correo" autocomplete="username" />
        <label asp-for="Email">Correo electrónico</label>
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>
    <div class="form-floating mb-3">
        <input asp-for="Password" class="form-control" placeholder="Contraseña" autocomplete="current-password" />
        <label asp-for="Password">Contraseña</label>
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="Recordarme" class="form-check-input" />
        <label asp-for="Recordarme" class="form-check-label">Recordarme</label>
    </div>
    <button class="btn btn-primary w-100">Entrar</button>
</form>

<p class="text-center mt-3 mb-0">¿No tienes cuenta? <a asp-action="Registro">Regístrate</a></p>